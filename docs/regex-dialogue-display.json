{
  "id": "chromatic-dialogue-dialogue-display",
  "scriptName": "Chromatic Dialogue - Dialogue display",
  "findRegex": "/\\[c([1-9]\\d?)(?::(whisper|shout|measured|tremble))?\\]([\\s\\S]*?)\\[\\/c\\]/g",
  "replaceString": "<span class=\"cd-c$1 cd-tone-$2\">“$3”</span>",
  "trimStrings": [],
  "placement": [
    2
  ],
  "disabled": false,
  "markdownOnly": true,
  "promptOnly": false,
  "runOnEdit": true,
  "substituteRegex": 0,
  "minDepth": 0,
  "maxDepth": 50
}